{
  "manifest_version": 3,
  "name": "Tab Stash - Hister Bridge",
  "version": "0.1.0",
  "description": "Bridges Firefox Tab Stash with the Hister search & archival engine",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-hister-bridge@frangonf.com",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Tab Stash ↔ Hister Bridge",
    "default_popup": "src/options.html"
  },
  "permissions": [
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:4433/*",
    "http://localhost:4433/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["dist/background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
