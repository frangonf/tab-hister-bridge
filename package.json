{
  "name": "tab-hister-bridge",
  "version": "0.1.0",
  "description": "Sidecar bridge connecting Firefox Tab Stash with Hister archival search engine",
  "main": "dist/background.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "oxlint --format=default",
    "lint:fix": "oxlint --fix --format=default",
    "backfill": "tsx scripts/backfill.ts"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^26.6.1",
    "happy-dom": "^20.14.5",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.7",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0"
  },
  "license": "MIT",
  "dependencies": {
    "defuddle": "0.19.4"
  }
}
